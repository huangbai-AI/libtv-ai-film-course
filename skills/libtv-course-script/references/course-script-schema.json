{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:libtv:schemas:course-detailed-script:1",
  "title": "LibTV AI 影视课程细化脚本",
  "description": "总目录 → 每节大纲 → 下挂细化脚本三级结构中的第三级规范化数据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "columns",
    "lesson",
    "documentHierarchy",
    "outlineSource",
    "contentGroups"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "columns": {
      "type": "array",
      "prefixItems": [
        {"const": "阶段"},
        {"const": "大纲"},
        {"const": "内容"},
        {"const": "口播"},
        {"const": "截图"},
        {"const": "备注"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "lesson": {
      "type": "string",
      "minLength": 1
    },
    "documentHierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootDirectoryDocument",
        "lessonOutlineDocument",
        "detailedScriptDocument"
      ],
      "properties": {
        "rootDirectoryDocument": {"$ref": "#/$defs/documentRef"},
        "lessonOutlineDocument": {"$ref": "#/$defs/documentRef"},
        "detailedScriptDocument": {"$ref": "#/$defs/documentRef"}
      }
    },
    "outlineSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "revisionId"],
      "properties": {
        "documentId": {"type": "string", "minLength": 1},
        "revisionId": {"type": ["string", "integer"]}
      }
    },
    "contentGroups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contentGroup"}
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "title"],
      "properties": {
        "documentId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "contentGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "outline", "content", "sourceOrder", "lines"],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1,
          "description": "逐字复制自父级主文档的阶段。"
        },
        "outline": {
          "type": "string",
          "minLength": 1,
          "description": "逐字复制自父级主文档的大纲。"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "逐字复制自父级主文档的内容。"
        },
        "sourceOrder": {
          "type": "integer",
          "minimum": 1,
          "description": "父级主文档中的顺序，不得在细化脚本中重排。"
        },
        "sourceFingerprint": {
          "type": "string",
          "minLength": 1,
          "description": "可选；父级修订号与阶段、大纲、内容的哈希，用于检测结构变化。"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/spokenLine"}
        }
      }
    },
    "spokenLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spoken", "visual"],
      "properties": {
        "spoken": {
          "type": "string",
          "minLength": 1,
          "description": "口播：一句话一个对象，渲染为一个单元格。"
        },
        "visual": {
          "type": "string",
          "minLength": 1,
          "description": "截图：与本句口播一一对应的截图、录屏或 B-roll。"
        },
        "note": {
          "type": "string",
          "description": "备注：可选，可为空字符串。"
        }
      }
    }
  }
}
